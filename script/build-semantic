#!/bin/sh
set -e
cd "$(dirname "$0")/.."
stats="${VERBOSE:+--stats}"
if [ -z "$LLVM_CONFIG" ]; then
  for candidate in /opt/homebrew/opt/llvm/bin/llvm-config /usr/local/opt/llvm/bin/llvm-config "$(command -v llvm-config || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      LLVM_CONFIG="$candidate"
      break
    fi
  done
fi
if [ -z "$LLVM_CONFIG" ]; then
  echo "llvm-config not found; set LLVM_CONFIG to build the semantic helper" >&2
  exit 1
fi
if [ -z "$SKIP_SHARDS" ]; then
  shards check >/dev/null 2>&1 || shards install
fi
mkdir -p bin
echo "llvm-config: $LLVM_CONFIG"
printf '\033[1;33mwarning:\033[0m this compiles the whole Crystal compiler in release mode.\n         A fresh build can sit at Codegen for several minutes.\n'
started=$(date +%s)
LLVM_CONFIG="$LLVM_CONFIG" crystal build tools/semantic.cr --release --no-debug --progress $stats -o bin/heucristic-semantic
echo "built bin/heucristic-semantic in $(($(date +%s) - started))s"
