require "json"

module Heucristic
  module Index
    record MacroSite,
      line : Int32,
      owner : String,
      name : String,
      metaclass : Bool,
      macro_name : String,
      macro_path : String?,
      macro_line : Int32?,
      expanded_path : String?,
      expanded_line : Int32?,
      expanded_column : Int32?,
      private_to : String? = nil do
      include JSON::Serializable

      def provenance(root : String) : String
        origin = macro_path ? "#{relative(macro_path, root)}:#{macro_line}" : "an unknown location"
        text = "generated by `#{macro_name}` (#{origin})"
        return text unless expanded_path

        "#{text} expanded at #{relative(expanded_path, root)}:#{expanded_line}"
      end

      private def relative(path : String?, root : String) : String
        return "" unless path

        path.starts_with?(root) ? path.lchop(root).lchop('/') : ::File.basename(path)
      end
    end
  end
end
