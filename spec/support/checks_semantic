#!/bin/sh
root="$2"
stdlib=$(crystal env CRYSTAL_PATH | tr ':' '\n' | grep -v '^lib$' | head -1)
library=$(find "$stdlib" -name '*.cr' -not -path '*/spec/*' -not -name 'spec.cr')
application=$(find "$root/app" -name '*.cr')
files=$(printf '%s\n%s\n' "$library" "$application" | sed 's/.*/"&"/' | paste -sd, -)
printf '{"crystal":"test","elapsed_ms":1.0,"source":"","sites":[],"files":["%s/src/checks.cr",%s]}\n' "$root" "$files"
